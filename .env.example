# =============================================================================
# Environment variables for boostsocial / pinoyboosting.com
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit real
# secrets. All values below are placeholders only.
# =============================================================================

# --- Primary Supabase project -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Full DB admin key — bypasses RLS. Keep server-side only, never expose.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Postgres connection strings ----------------------------------------------
# Used by DB maintenance scripts (import-data.mjs uses IMPORT_DATABASE_URL).
DATABASE_URL="postgresql://user:password@host:6543/postgres"
DIGITALOCEAN_DATABASE_URL="postgresql://user:password@host:5432/db"
IMPORT_DATABASE_URL="postgresql://user:password@host:6543/postgres"

# --- Backup Supabase projects (optional; enable as many as needed) -----------
BACKUP_SUPABASE_URL="https://your-backup.supabase.co"
BACKUP_SUPABASE_SERVICE_ROLE_KEY="your-backup-service-role-key"
BACKUP_DATABASE_URL="postgresql://user:password@host:6543/postgres"
BACKUP3_SUPABASE_URL=""
BACKUP3_SUPABASE_SERVICE_ROLE_KEY=""
BACKUP3_DATABASE_URL=""
BACKUP4_SUPABASE_URL=""
BACKUP4_SUPABASE_SERVICE_ROLE_KEY=""
BACKUP4_DATABASE_URL=""
BACKUP5_SUPABASE_URL=""
BACKUP5_SUPABASE_SERVICE_ROLE_KEY=""
BACKUP5_DATABASE_URL=""

# --- Transactional email (Resend) --------------------------------------------
# Also referenced by supabase/config.toml via env(RESEND_API_KEY).
RESEND_API_KEY="re_your_resend_api_key"

# --- SMM provider (RixeySMM) --------------------------------------------------
RIXEYSMM_API_KEY="your-rixeysmm-api-key"
RIXEYSMM_LOW_BALANCE_THRESHOLD="100"

# --- Admin authorization ------------------------------------------------------
# Comma-separated allowlist of admin emails, or an allowed domain.
ADMIN_EMAILS="admin@example.com"
ADMIN_EMAIL_DOMAIN=""

# --- Telegram bots ------------------------------------------------------------
TELEGRAM_ORDER_BOT_TOKEN="your-order-bot-token"
TELEGRAM_ORDER_CHAT_ID="your-order-chat-id"
TELEGRAM_TOPUP_BOT_TOKEN="your-topup-bot-token"
TELEGRAM_TOPUP_CHAT_ID="your-topup-chat-id"
# Shared secret validated against x-telegram-bot-api-secret-token on webhooks.
TELEGRAM_WEBHOOK_SECRET="your-webhook-secret"

# --- Cron ---------------------------------------------------------------------
# Bearer token required by /api/cron/* endpoints.
CRON_SECRET="your-cron-secret"

# --- Web Push (VAPID) ---------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# --- AI / chat providers (optional) -------------------------------------------
OPENCODE_API_KEY=""
OPENCODE_ZEN_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
POLLINATIONS_TEXT_MODEL="openai"
POLLINATIONS_MODEL="openai"
